# Configuração do site na Hostinger (servidor Apache).
# Este arquivo precisa ir para public_html junto com o index.html.
# Ele começa com ponto, então o Gerenciador de Arquivos pode escondê-lo:
# ative "Mostrar arquivos ocultos" para vê-lo.

# ---------- Força HTTPS ----------
# Sem isso, quem digitar o endereço sem https entra numa versão insegura,
# e o navegador mostra "Não seguro" ao lado do endereço.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Um endereço só: sempre com www, para não dividir métricas de anúncio.
  # Se preferir SEM www, apague estas duas linhas e descomente as duas de baixo.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

  # Permite acessar /metodo sem precisar digitar .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache das imagens ----------
# Imagens ficam guardadas no navegador por um ano; o HTML nunca é guardado,
# para que qualquer alteração na página apareça na hora.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Tipo do WebP ----------
# Alguns servidores antigos não conhecem o formato e as imagens não abrem.
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ---------- Proteção ----------
# Bloqueia qualquer arquivo de dados ou de configuração que acabe subindo
# por engano para a pasta pública.
<FilesMatch "^(leads.*\.json|server\.js|google-apps-script\.js|package.*\.json|\.git.*|.*\.mjs)$">
  Require all denied
</FilesMatch>

# ---------- Página de erro ----------
ErrorDocument 404 /index.html
